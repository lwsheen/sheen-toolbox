  {
    "title": "二、建筑防火与平面布置",
    "items": [
      {
        "text": "违规设置住宿（查看是否在严禁设置住宿的区域住人，如地下、半地下、甲/乙类厂房、危化品仓库等）",
        "ref": "GB 50016",
        "id": "s0_0"
      },
      {
        "text": "防火分隔（住宿部分与非住宿部分是否采用实体墙、楼板完全分隔；确需连通时是否设置甲级防火门；有无孔洞、缝隙）",
        "ref": "GB 50016",
        "id": "s0_1"
      },
      {
        "text": "安全出口（住宿部分与非住宿部分是否分别设置独立安全出口；数量不少于2个；出口有无锁闭、堵塞）",
        "ref": "GB 50016",
        "id": "s0_2"
      },
      {
        "text": "疏散通道（疏散通道、楼梯间是否畅通，宽度符合要求，无货物、杂物占用）",
        "ref": "GB 50016",
        "id": "s0_3"
      },
      {
        "text": "疏散门（疏散门是否向疏散方向开启；是否违规使用卷帘门、吊门、推拉门）",
        "ref": "GB 50016",
        "id": "s0_4"
      },
      {
        "text": "外窗逃生条件（外窗是否设置影响逃生和救援的防盗网；已设置的应开设逃生口或拆除）",
        "ref": "GB 50016",
        "id": "s0_5"
      },
      {
        "text": "建筑结构/材料（是否违规使用泡沫夹芯彩钢板、易燃材料搭建或装修）",
        "ref": "GB 50016",
        "id": "s0_6"
      },
      {
        "text": "防火间距/消防车道（防火间距、消防车道是否被占用、堵塞，影响消防车通行）",
        "ref": "GB 50016",
        "id": "s0_7"
      }
    ]
  },
  {
    "title": "三、消防设施器材",
    "items": [
      {
        "text": "灭火器（配置类型、数量、压力、有效期符合要求，摆放位置明显、便于取用）",
        "ref": "GB 50140",
        "id": "s1_0"
      },
      {
        "text": "独立式感烟探测器（住宿、经营、储存区域顶部是否安装独立式感烟火灾探测报警器，功能正常）",
        "ref": "GB 50116",
        "id": "s1_1"
      },
      {
        "text": "应急照明（安全出口、疏散走道、楼梯间是否设置应急照明，断电后可正常启动）",
        "ref": "GB 51309",
        "id": "s1_2"
      },
      {
        "text": "疏散指示标志（疏散指示标志设置位置、方向是否正确，外观完好）",
        "ref": "GB 51309",
        "id": "s1_3"
      },
      {
        "text": "简易喷淋/消火栓（按标准应设置简易喷淋或室内消火栓的，是否设置到位，水压、配件正常）",
        "ref": "GB 50974",
        "id": "s1_4"
      },
      {
        "text": "自动报警/自动灭火（达到设置条件的场所是否设置火灾自动报警系统或自动灭火系统并正常运行）",
        "ref": "GB 50116",
        "id": "s1_5"
      },
      {
        "text": "设施维护保养（消防设施器材是否定期检查、维护，有记录）",
        "ref": "GB 25201",
        "id": "s1_6"
      }
    ]
  },
  {
    "title": "四、用火用电用气管理",
    "items": [
      {
        "text": "电气线路（电气线路是否穿管保护，无私拉乱接、老化、破损现象）",
        "ref": "GB 50054",
        "id": "s2_0"
      },
      {
        "text": "配电箱（配电箱是否安装漏电保护器，箱内及周围无可燃物堆放）",
        "ref": "GB 50054",
        "id": "s2_1"
      },
      {
        "text": "大功率电器（是否违规使用电热毯、电炉、热得快等大功率电器；电气设备与可燃物是否保持安全距离）",
        "ref": "GB 50054",
        "id": "s2_2"
      },
      {
        "text": "电动自行车（电动自行车是否违规在室内、疏散通道、楼梯间停放或充电）",
        "ref": "应急管理部令第5号",
        "id": "s2_3"
      },
      {
        "text": "燃气使用（燃气气瓶存放、软管、阀门是否符合要求，是否安装可燃气体报警器）",
        "ref": "CJJ 12",
        "id": "s2_4"
      },
      {
        "text": "明火管理（是否违规使用明火取暖、做饭；动火作业是否经过审批并落实防护措施）",
        "ref": "GB 50720",
        "id": "s2_5"
      },
      {
        "text": "易燃易爆物品（是否违规存放油漆、汽油、烟花爆竹等易燃易爆危险品）",
        "ref": "GB 15603",
        "id": "s2_6"
      }
    ]
  },
  {
    "title": "五、消防安全管理",
    "items": [
      {
        "text": "消防安全制度（是否明确消防安全责任人，建立消防安全管理制度）",
        "ref": "GB 19600",
        "id": "s3_0"
      },
      {
        "text": "防火巡查（是否每日开展防火巡查，并有记录）",
        "ref": "GB 19600",
        "id": "s3_1"
      },
      {
        "text": "消防标识（是否设置禁止吸烟、安全出口等消防安全标识）",
        "ref": "GB 2894",
        "id": "s3_2"
      },
      {
        "text": "培训演练（员工是否掌握报警、使用灭火器、组织疏散逃生等技能；是否定期组织演练）",
        "ref": "GB 19600",
        "id": "s3_3"
      },
      {
        "text": "住宿管理（住宿人数是否超标，是否存在违规使用明火、大功率电器等情况）",
        "ref": "GB 50016",
        "id": "s3_4"
      },
      {
        "text": "隐患整改（以往检查发现的火灾隐患是否已整改闭环）",
        "ref": "GB 19600",
        "id": "s3_5"
      }
    ]
  }
]